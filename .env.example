# Optional command overrides.
# LARK_CLI="lark-cli"
# CODEX_CMD="codex"

# Default: disabled. Set to true only after validating your callback target.
FEISHU_APP_CODEX_ENABLE_CALLBACK=false

# Optional bridge tuning.
FEISHU_APP_CODEX_PROGRESS_INTERVAL=30
FEISHU_APP_CODEX_FALLBACK_MESSAGE_INTERVAL=60
FEISHU_APP_CODEX_UPDATE_INTERVAL=0.8

